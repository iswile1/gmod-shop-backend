# Serveur
PORT=3001
NODE_ENV=development

# Base de données (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/gmodshop

# Base de données (MongoDB - alternative)
# MONGODB_URI=mongodb://localhost:27017/gmodshop

# JWT
JWT_SECRET=votre_secret_jwt_super_securise_changez_moi
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_votre_cle_stripe
STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_stripe
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=votre_client_id_paypal
PAYPAL_CLIENT_SECRET=votre_client_secret_paypal
PAYPAL_MODE=sandbox

# Paysafecard (optionnel)
PAYSAFECARD_API_URL=https://api.paysafecard.com
PAYSAFECARD_API_KEY=votre_cle_api_paysafecard

# GMod Integration
GMOD_API_KEY=votre_cle_api_gmod_securisee
GMOD_SERVER_URL=http://votre-serveur-gmod:port
GMOD_API_ENDPOINT=http://votre-serveur-gmod:port/api

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:3000

# Steam Authentication
STEAM_API_KEY=votre_cle_api_steam
STEAM_REALM=http://localhost:3000
STEAM_RETURN_URL=http://localhost:3001/api/auth/steam/return

# Session Secret (pour les sessions Steam)
SESSION_SECRET=votre_secret_session_super_securise_changez_moi
